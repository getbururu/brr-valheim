// Valheim's sensors: Player.log, the log Unity writes while the game
// runs. The game process comes from the manifest; the controller is
// always there.
{
  "sensors": 1,
  "items": {
    "log": { "type": "file.text", "order": 10,
             "dir": "{path:logs}", "glob": "Player.log",
             "pick": "newest_mtime", "rescan_ms": 2000,
             // lines written before Bururu started rebuild where the
             // player is, and play nothing
             "catch_up": "state_only", "poll_ms": 100,
             "lines": {
               // the main menu opens: at the start ("Valheim version: 1.0.17
               // (network version 35)") and after leaving a world ("Net scene
               // destroyed")
               "menu":  { "re": "Valheim version:|Net scene destroyed" },
               // a world loads, your own or someone else's
               "world": { "re": "Loading main scene" },
               // a raid starts ("Random event set:army_eikthyr"). Written on
               // every PC in the world, also for a raid at another player's base
               "raid":  { "re": "Random event set:\\s*(?P<event>\\S+)" },
               // everyone is in bed and the night skips ("Time 3412.52, day:3
               // nextm:4590  skipspeed:98.12"). Written only where the world runs
               "sleep": { "re": "\\bTime [0-9.,]+, day:(?P<day>\\d+)\\s+nextm:" },
               // the rules below only mark names, ids, addresses and chat, so
               // recordings leave them out
               "player":    { "re": "(?:persona:\\s*|Loading player profile |Teleporting |Got character ZDOID from )(?P<name>.+?)(?: : .*)?$" },
               "world_name": { "re": "Load world:\\s*(?P<world>.+)$" },
               "server":    { "re": "(?:Joining server '|Failed to join server '|Server Name : |Got join server data )(?P<server>[^']+)" },
               "save_file": { "re": "(?P<file>/(?:characters|worlds)(?:_local)?/.*)$" },
               "user_dir":  { "re": "(?:[A-Za-z]:[\\\\/]Users|/home)[\\\\/](?P<user>[^\\\\/'\\s]+)" },
               "chat":      { "re": "Console: (?P<text>.*)$" },
               // Steam, PlayFab and lobby ids; the first two of a line
               "player_id": { "re": "(?:_|\\b)(?P<id>[0-9A-F]{14,20})\\b(?:.*?(?:_|\\b)(?P<id2>[0-9A-F]{14,20})\\b)?" },
               "address":   { "re": "(?P<ip>\\b\\d{1,3}(?:\\.\\d{1,3}){3}(?::\\d+)?\\b)" }
             },
             "redact": { "player": ["name"], "world_name": ["world"], "server": ["server"],
                         "save_file": ["file"], "user_dir": ["user"], "chat": ["text"],
                         "player_id": ["id", "id2"], "address": ["ip"] },
             "patchable": ["dir", "rescan_ms", "lines"] }
  }
}
